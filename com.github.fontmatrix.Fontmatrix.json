{
    "id": "com.github.fontmatrix.Fontmatrix",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "rename-icon": "fontmatrix",
    "command": "fontmatrix",
    "separate-locales": false,
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-data/fonts:create",
        "--filesystem=xdg-config/fontconfig:create",
        "--persist=.Fontmatrix"
    ],
    "cleanup": [
        "/share/man"
    ],
    "modules": [
        {
            "name": "podofo",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DBUILD_SHARED_LIBS=OFF",
                "-DPODOFO_WITH_FONTMANAGER=OFF",
                "-DPODOFO_BUILD_TEST=OFF",
                "-DPODOFO_BUILD_EXAMPLES=OFF",
                "-DPODOFO_BUILD_UNSUPPORTED_TOOLS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/podofo/podofo/archive/refs/tags/1.1.3.tar.gz",
                    "sha256": "9fe13b87148cd9691dc7f5b40dca9ce789576c131fe65e90a09e163a4fb25c31",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 10527,
                        "stable-only": true,
                        "url-template": "https://github.com/podofo/podofo/archive/refs/tags/$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "fontmatrix",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_DISABLE_FIND_PACKAGE_KF6Auth=ON"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/fontmatrix/fontmatrix.git",
                    "tag": "v1.0.1",
                    "commit": "72193ac819096bc26aef15336572991da54cdbad",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
